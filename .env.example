# 复制为 .env 后修改。docker-compose 里也可以直接用 environment 覆盖。
# 所有变量前缀 CSM_

# 数据目录（容器内默认 /data，本地开发默认 ./runtime）
CSM_DATA_DIR=./runtime

# 会话签名密钥。
# 留空或保持默认值时，程序会在数据目录自动生成一份随机密钥并保存为 data/secret.key，
# 所以「什么都不配」也是安全的。只有要在多实例间共享登录态时才需要显式指定。
CSM_SECRET_KEY=

# 初始管理员账号（仅首次启动、数据库为空时写入）
CSM_ADMIN_USER=admin
CSM_ADMIN_PASSWORD=admin123

# 监听
CSM_HOST=0.0.0.0
CSM_PORT=8080

# 时区（决定定时推送与菜谱日期）
CSM_TIMEZONE=Asia/Shanghai

# 可选：启动时自动从 GitHub 更新本地菜谱库（默认关）
CSM_AUTO_UPDATE_LIBRARY=false

# 可选：强制访问模式，覆盖 WebUI 里的「访问控制」设置
# 留空 = 用网页里的设置（默认「免登录」，打开即用）
# 设为 password = 强制要求登录，适合会暴露到公网的部署
# CSM_AUTH_MODE=password
