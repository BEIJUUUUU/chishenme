.gitignore
.gitattributes
/.venv
/venv
/env
/runtime
/data
/.pytest-runtime
__pycache__
*.pyc
*.pyo
*.pyd
.pytest_cache
.ruff_cache
.mypy_cache
*.db
*.db-journal
*.sqlite3
/tests
/.github
/.idea
/.vscode
.DS_Store
Thumbs.db
*.md
